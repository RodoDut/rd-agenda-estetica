includes:
  - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
  level: 5
  paths:
    - wp-content/plugins/rdt-centros-core/includes
  scanFiles:
    - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
  excludes_analyse:
    - vendor
  inferPrivatePropertyTypeFromConstructor: true
